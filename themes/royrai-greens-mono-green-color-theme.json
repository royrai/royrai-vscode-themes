{
  "name": "RoyrAI Greens Mono Green",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#1b4332",
    "foreground": "#cee6de",
    "editor.background": "#0c1212",
    "editor.foreground": "#cee6de",
    "editorLineNumber.foreground": "#5a6764",
    "editorLineNumber.activeForeground": "#74c69c",
    "editorCursor.foreground": "#74c69c",
    "editor.selectionBackground": "#11211c",
    "editor.selectionHighlightBackground": "#1b433222",
    "editor.lineHighlightBackground": "#181f1e",
    "editor.findMatchBackground": "#74c69c55",
    "editor.findMatchHighlightBackground": "#74c69c33",
    "editorWhitespace.foreground": "#2f3837",
    "editorIndentGuide.background1": "#232b2a",
    "editorIndentGuide.activeBackground1": "#46524f",
    "editorBracketMatch.border": "#74c69c",
    "editorWidget.background": "#090e0e",
    "editorHoverWidget.background": "#090e0e",
    "editorSuggestWidget.background": "#090e0e",
    "editorSuggestWidget.selectedBackground": "#11211c",
    "sideBar.background": "#090e0e",
    "sideBar.foreground": "#b1c6bf",
    "sideBarTitle.foreground": "#cee6de",
    "sideBarSectionHeader.background": "#070a0a",
    "activityBar.background": "#070a0a",
    "activityBar.foreground": "#74c69c",
    "activityBar.inactiveForeground": "#63716e",
    "activityBarBadge.background": "#1b4332",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#070a0a",
    "titleBar.activeForeground": "#cee6de",
    "titleBar.inactiveBackground": "#070a0a",
    "statusBar.background": "#070a0a",
    "statusBar.foreground": "#bbd1ca",
    "statusBar.noFolderBackground": "#070a0a",
    "statusBar.debuggingBackground": "#1b4332",
    "tab.activeBackground": "#0c1212",
    "tab.inactiveBackground": "#090e0e",
    "tab.activeForeground": "#cee6de",
    "tab.inactiveForeground": "#6d7c78",
    "tab.activeBorderTop": "#74c69c",
    "tab.border": "#070a0a",
    "editorGroupHeader.tabsBackground": "#090e0e",
    "editorGroup.border": "#070a0a",
    "panel.background": "#0c1212",
    "panel.border": "#070a0a",
    "panelTitle.activeForeground": "#cee6de",
    "panelTitle.inactiveForeground": "#6d7c78",
    "list.activeSelectionBackground": "#11211c",
    "list.activeSelectionForeground": "#cee6de",
    "list.hoverBackground": "#181f1e",
    "list.highlightForeground": "#74c69c",
    "badge.background": "#1b4332",
    "badge.foreground": "#ffffff",
    "button.background": "#1b4332",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#365b4c",
    "progressBar.background": "#74c69c",
    "input.background": "#181f1e",
    "input.foreground": "#cee6de",
    "input.border": "#293231",
    "inputOption.activeBorder": "#74c69c",
    "dropdown.background": "#090e0e",
    "scrollbarSlider.background": "#cee6de22",
    "scrollbarSlider.hoverBackground": "#cee6de33",
    "scrollbarSlider.activeBackground": "#cee6de44",
    "textLink.foreground": "#74c69c",
    "textLink.activeForeground": "#40916c",
    "gitDecoration.modifiedResourceForeground": "#74c69c",
    "gitDecoration.addedResourceForeground": "#40916c",
    "gitDecoration.deletedResourceForeground": "#e0605e",
    "gitDecoration.untrackedResourceForeground": "#1b4332",
    "terminal.background": "#0c1212",
    "terminal.foreground": "#cee6de",
    "terminalCursor.foreground": "#74c69c",
    "minimap.selectionHighlight": "#1b4332"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6d7c78",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#40916c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#5aac84"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#1b4332"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#90a29d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#74c69c"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#82cba6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cee6de"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#b8dece"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#1b4332",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#1b4332"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#74c69c"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7dc9a3"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#74c69c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#40916c"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
