{
  "name": "RoyrAI Tech Signature Chip",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#0fa4a0",
    "foreground": "#eef0f6",
    "editor.background": "#11161b",
    "editor.foreground": "#eef0f6",
    "editorLineNumber.foreground": "#696d73",
    "editorLineNumber.activeForeground": "#dfe6ee",
    "editorCursor.foreground": "#dfe6ee",
    "editor.selectionBackground": "#104143",
    "editor.selectionHighlightBackground": "#0fa4a022",
    "editor.lineHighlightBackground": "#1e2328",
    "editor.findMatchBackground": "#dfe6ee55",
    "editor.findMatchHighlightBackground": "#dfe6ee33",
    "editorWhitespace.foreground": "#393d42",
    "editorIndentGuide.background1": "#2c3035",
    "editorIndentGuide.activeBackground1": "#53575d",
    "editorBracketMatch.border": "#dfe6ee",
    "editorWidget.background": "#0d1114",
    "editorHoverWidget.background": "#0d1114",
    "editorSuggestWidget.background": "#0d1114",
    "editorSuggestWidget.selectedBackground": "#104143",
    "sideBar.background": "#0d1114",
    "sideBar.foreground": "#cdcfd5",
    "sideBarTitle.foreground": "#eef0f6",
    "sideBarSectionHeader.background": "#090c0f",
    "activityBar.background": "#6b7684",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#aeb4bb",
    "activityBarBadge.background": "#0fa4a0",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#090c0f",
    "titleBar.activeForeground": "#eef0f6",
    "titleBar.inactiveBackground": "#090c0f",
    "statusBar.background": "#6b7684",
    "statusBar.foreground": "#f0f1f3",
    "statusBar.noFolderBackground": "#6b7684",
    "statusBar.debuggingBackground": "#0fa4a0",
    "tab.activeBackground": "#11161b",
    "tab.inactiveBackground": "#0d1114",
    "tab.activeForeground": "#eef0f6",
    "tab.inactiveForeground": "#808389",
    "tab.activeBorderTop": "#dfe6ee",
    "tab.border": "#090c0f",
    "editorGroupHeader.tabsBackground": "#0d1114",
    "editorGroup.border": "#090c0f",
    "panel.background": "#11161b",
    "panel.border": "#090c0f",
    "panelTitle.activeForeground": "#eef0f6",
    "panelTitle.inactiveForeground": "#808389",
    "list.activeSelectionBackground": "#104143",
    "list.activeSelectionForeground": "#eef0f6",
    "list.hoverBackground": "#1e2328",
    "list.highlightForeground": "#dfe6ee",
    "badge.background": "#0fa4a0",
    "badge.foreground": "#ffffff",
    "button.background": "#0fa4a0",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#30afad",
    "progressBar.background": "#dfe6ee",
    "input.background": "#1e2328",
    "input.foreground": "#eef0f6",
    "input.border": "#32373c",
    "inputOption.activeBorder": "#dfe6ee",
    "dropdown.background": "#0d1114",
    "scrollbarSlider.background": "#eef0f622",
    "scrollbarSlider.hoverBackground": "#eef0f633",
    "scrollbarSlider.activeBackground": "#eef0f644",
    "textLink.foreground": "#dfe6ee",
    "textLink.activeForeground": "#f7ce46",
    "gitDecoration.modifiedResourceForeground": "#dfe6ee",
    "gitDecoration.addedResourceForeground": "#f7ce46",
    "gitDecoration.deletedResourceForeground": "#e76263",
    "gitDecoration.untrackedResourceForeground": "#0fa4a0",
    "terminal.background": "#11161b",
    "terminal.foreground": "#eef0f6",
    "terminalCursor.foreground": "#dfe6ee",
    "minimap.selectionHighlight": "#0fa4a0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#808389",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f7ce46"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#ebda9a"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#0fa4a0"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a7aab0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#dfe6ee"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#e1e8ef"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#eef0f6"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#eaeef4"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#0fa4a0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#0fa4a0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#dfe6ee"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#e1e7ef"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#dfe6ee",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#f7ce46"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
