{
  "name": "RoyrAI Metals Metalic Wealth",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#d4a72c",
    "foreground": "#eeeff5",
    "editor.background": "#32200c",
    "editor.foreground": "#eeeff5",
    "editorLineNumber.foreground": "#7d7369",
    "editorLineNumber.activeForeground": "#f5d76e",
    "editorCursor.foreground": "#f5d76e",
    "editor.selectionBackground": "#634916",
    "editor.selectionHighlightBackground": "#d4a72c22",
    "editor.lineHighlightBackground": "#3d2c1a",
    "editor.findMatchBackground": "#f5d76e55",
    "editor.findMatchHighlightBackground": "#f5d76e33",
    "editorWhitespace.foreground": "#544536",
    "editorIndentGuide.background1": "#493928",
    "editorIndentGuide.activeBackground1": "#6a5e52",
    "editorBracketMatch.border": "#f5d76e",
    "editorWidget.background": "#261809",
    "editorHoverWidget.background": "#261809",
    "editorSuggestWidget.background": "#261809",
    "editorSuggestWidget.selectedBackground": "#634916",
    "sideBar.background": "#261809",
    "sideBar.foreground": "#d2d0d2",
    "sideBarTitle.foreground": "#eeeff5",
    "sideBarSectionHeader.background": "#1c1207",
    "activityBar.background": "#83641c",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#bbaa82",
    "activityBarBadge.background": "#d4a72c",
    "activityBarBadge.foreground": "#111111",
    "titleBar.activeBackground": "#1c1207",
    "titleBar.activeForeground": "#eeeff5",
    "titleBar.inactiveBackground": "#1c1207",
    "statusBar.background": "#83641c",
    "statusBar.foreground": "#f3f0e8",
    "statusBar.noFolderBackground": "#83641c",
    "statusBar.debuggingBackground": "#d4a72c",
    "tab.activeBackground": "#32200c",
    "tab.inactiveBackground": "#261809",
    "tab.activeForeground": "#eeeff5",
    "tab.inactiveForeground": "#908881",
    "tab.activeBorderTop": "#f5d76e",
    "tab.border": "#1c1207",
    "editorGroupHeader.tabsBackground": "#261809",
    "editorGroup.border": "#1c1207",
    "panel.background": "#32200c",
    "panel.border": "#1c1207",
    "panelTitle.activeForeground": "#eeeff5",
    "panelTitle.inactiveForeground": "#908881",
    "list.activeSelectionBackground": "#634916",
    "list.activeSelectionForeground": "#eeeff5",
    "list.hoverBackground": "#3d2c1a",
    "list.highlightForeground": "#f5d76e",
    "badge.background": "#d4a72c",
    "badge.foreground": "#111111",
    "button.background": "#d4a72c",
    "button.foreground": "#111111",
    "button.hoverBackground": "#d8b24a",
    "progressBar.background": "#f5d76e",
    "input.background": "#3d2c1a",
    "input.foreground": "#eeeff5",
    "input.border": "#4e3f2f",
    "inputOption.activeBorder": "#f5d76e",
    "dropdown.background": "#261809",
    "scrollbarSlider.background": "#eeeff522",
    "scrollbarSlider.hoverBackground": "#eeeff533",
    "scrollbarSlider.activeBackground": "#eeeff544",
    "textLink.foreground": "#f5d76e",
    "textLink.activeForeground": "#dfe4e8",
    "gitDecoration.modifiedResourceForeground": "#f5d76e",
    "gitDecoration.addedResourceForeground": "#dfe4e8",
    "gitDecoration.deletedResourceForeground": "#e76163",
    "gitDecoration.untrackedResourceForeground": "#d4a72c",
    "terminal.background": "#32200c",
    "terminal.foreground": "#eeeff5",
    "terminalCursor.foreground": "#f5d76e",
    "minimap.selectionHighlight": "#d4a72c"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#908881",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#dfe4e8"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#eadeab"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#d4a72c"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#b2adaa"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#f5d76e"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#f4db82"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#eeeff5"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#f0e9d3"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#d4a72c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#d4a72c"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f5d76e"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#f4d97c"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f5d76e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#dfe4e8"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
