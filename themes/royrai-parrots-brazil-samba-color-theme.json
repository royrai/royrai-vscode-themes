{
  "name": "RoyrAI Parrots Brazil Samba",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#009c3b",
    "foreground": "#f7eeaf",
    "editor.background": "#07220e",
    "editor.foreground": "#f7eeaf",
    "editorLineNumber.foreground": "#67744e",
    "editorLineNumber.activeForeground": "#2f6fd6",
    "editorCursor.foreground": "#2f6fd6",
    "editor.selectionBackground": "#05471c",
    "editor.selectionHighlightBackground": "#009c3b22",
    "editor.lineHighlightBackground": "#152e18",
    "editor.findMatchBackground": "#2f6fd655",
    "editor.findMatchHighlightBackground": "#2f6fd633",
    "editorWhitespace.foreground": "#32472b",
    "editorIndentGuide.background1": "#243a21",
    "editorIndentGuide.activeBackground1": "#4f5f3e",
    "editorBracketMatch.border": "#2f6fd6",
    "editorWidget.background": "#051a0b",
    "editorHoverWidget.background": "#051a0b",
    "editorSuggestWidget.background": "#051a0b",
    "editorSuggestWidget.selectedBackground": "#05471c",
    "sideBar.background": "#051a0b",
    "sideBar.foreground": "#d3cf97",
    "sideBarTitle.foreground": "#f7eeaf",
    "sideBarSectionHeader.background": "#041308",
    "activityBar.background": "#002776",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#7388b4",
    "activityBarBadge.background": "#009c3b",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#041308",
    "titleBar.activeForeground": "#f7eeaf",
    "titleBar.inactiveBackground": "#041308",
    "statusBar.background": "#002776",
    "statusBar.foreground": "#e6e9f1",
    "statusBar.noFolderBackground": "#002776",
    "statusBar.debuggingBackground": "#009c3b",
    "tab.activeBackground": "#07220e",
    "tab.inactiveBackground": "#051a0b",
    "tab.activeForeground": "#f7eeaf",
    "tab.inactiveForeground": "#7f885f",
    "tab.activeBorderTop": "#2f6fd6",
    "tab.border": "#041308",
    "editorGroupHeader.tabsBackground": "#051a0b",
    "editorGroup.border": "#041308",
    "panel.background": "#07220e",
    "panel.border": "#041308",
    "panelTitle.activeForeground": "#f7eeaf",
    "panelTitle.inactiveForeground": "#7f885f",
    "list.activeSelectionBackground": "#05471c",
    "list.activeSelectionForeground": "#f7eeaf",
    "list.hoverBackground": "#152e18",
    "list.highlightForeground": "#2f6fd6",
    "badge.background": "#009c3b",
    "badge.foreground": "#ffffff",
    "button.background": "#009c3b",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#25a84c",
    "progressBar.background": "#2f6fd6",
    "input.background": "#152e18",
    "input.foreground": "#f7eeaf",
    "input.border": "#2b4126",
    "inputOption.activeBorder": "#2f6fd6",
    "dropdown.background": "#051a0b",
    "scrollbarSlider.background": "#f7eeaf22",
    "scrollbarSlider.hoverBackground": "#f7eeaf33",
    "scrollbarSlider.activeBackground": "#f7eeaf44",
    "textLink.foreground": "#2f6fd6",
    "textLink.activeForeground": "#ffdf00",
    "gitDecoration.modifiedResourceForeground": "#2f6fd6",
    "gitDecoration.addedResourceForeground": "#ffdf00",
    "gitDecoration.deletedResourceForeground": "#e96155",
    "gitDecoration.untrackedResourceForeground": "#009c3b",
    "terminal.background": "#07220e",
    "terminal.foreground": "#f7eeaf",
    "terminalCursor.foreground": "#2f6fd6",
    "minimap.selectionHighlight": "#009c3b"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f885f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffdf00"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#97a76b"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#009c3b"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#aaad7b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#2f6fd6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#4d82d0"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#f7eeaf"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c5ceb9"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#009c3b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#009c3b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#2f6fd6"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#437cd2"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#2f6fd6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#ffdf00"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
