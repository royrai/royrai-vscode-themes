{
  "name": "RoyrAI Cool Turquoise Lagoon",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#38bdf8",
    "foreground": "#cff1f9",
    "editor.background": "#10232e",
    "editor.foreground": "#cff1f9",
    "editorLineNumber.foreground": "#5c757f",
    "editorLineNumber.activeForeground": "#7ae9f5",
    "editorCursor.foreground": "#7ae9f5",
    "editor.selectionBackground": "#1c516b",
    "editor.selectionHighlightBackground": "#38bdf822",
    "editor.lineHighlightBackground": "#1b2f3a",
    "editor.findMatchBackground": "#7ae9f555",
    "editor.findMatchHighlightBackground": "#7ae9f533",
    "editorWhitespace.foreground": "#324853",
    "editorIndentGuide.background1": "#273c46",
    "editorIndentGuide.activeBackground1": "#49616b",
    "editorBracketMatch.border": "#7ae9f5",
    "editorWidget.background": "#0c1a23",
    "editorHoverWidget.background": "#0c1a23",
    "editorSuggestWidget.background": "#0c1a23",
    "editorSuggestWidget.selectedBackground": "#1c516b",
    "sideBar.background": "#0c1a23",
    "sideBar.foreground": "#b2d2db",
    "sideBarTitle.foreground": "#cff1f9",
    "sideBarSectionHeader.background": "#091319",
    "activityBar.background": "#091319",
    "activityBar.foreground": "#7ae9f5",
    "activityBar.inactiveForeground": "#668089",
    "activityBarBadge.background": "#38bdf8",
    "activityBarBadge.foreground": "#111111",
    "titleBar.activeBackground": "#091319",
    "titleBar.activeForeground": "#cff1f9",
    "titleBar.inactiveBackground": "#091319",
    "statusBar.background": "#091319",
    "statusBar.foreground": "#bcdce5",
    "statusBar.noFolderBackground": "#091319",
    "statusBar.debuggingBackground": "#38bdf8",
    "tab.activeBackground": "#10232e",
    "tab.inactiveBackground": "#0c1a23",
    "tab.activeForeground": "#cff1f9",
    "tab.inactiveForeground": "#708a94",
    "tab.activeBorderTop": "#7ae9f5",
    "tab.border": "#091319",
    "editorGroupHeader.tabsBackground": "#0c1a23",
    "editorGroup.border": "#091319",
    "panel.background": "#10232e",
    "panel.border": "#091319",
    "panelTitle.activeForeground": "#cff1f9",
    "panelTitle.inactiveForeground": "#708a94",
    "list.activeSelectionBackground": "#1c516b",
    "list.activeSelectionForeground": "#cff1f9",
    "list.hoverBackground": "#1b2f3a",
    "list.highlightForeground": "#7ae9f5",
    "badge.background": "#38bdf8",
    "badge.foreground": "#111111",
    "button.background": "#38bdf8",
    "button.foreground": "#111111",
    "button.hoverBackground": "#4fc5f8",
    "progressBar.background": "#7ae9f5",
    "input.background": "#1b2f3a",
    "input.foreground": "#cff1f9",
    "input.border": "#2d424c",
    "inputOption.activeBorder": "#7ae9f5",
    "dropdown.background": "#0c1a23",
    "scrollbarSlider.background": "#cff1f922",
    "scrollbarSlider.hoverBackground": "#cff1f933",
    "scrollbarSlider.activeBackground": "#cff1f944",
    "textLink.foreground": "#7ae9f5",
    "textLink.activeForeground": "#2dd4bf",
    "gitDecoration.modifiedResourceForeground": "#7ae9f5",
    "gitDecoration.addedResourceForeground": "#2dd4bf",
    "gitDecoration.deletedResourceForeground": "#e16263",
    "gitDecoration.untrackedResourceForeground": "#38bdf8",
    "terminal.background": "#10232e",
    "terminal.foreground": "#cff1f9",
    "terminalCursor.foreground": "#7ae9f5",
    "minimap.selectionHighlight": "#38bdf8"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#708a94",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2dd4bf"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#54dfda"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#92afb8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7ae9f5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#87eaf6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cff1f9"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#baeff8"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7ae9f5"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#83eaf5"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7ae9f5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#2dd4bf"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
