{
  "name": "RoyrAI Warm Burgundy Night",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#d6416f",
    "foreground": "#e2edfc",
    "editor.background": "#10102a",
    "editor.foreground": "#e2edfc",
    "editorLineNumber.foreground": "#64687e",
    "editorLineNumber.activeForeground": "#b8dcff",
    "editorCursor.foreground": "#b8dcff",
    "editor.selectionBackground": "#4b1f3f",
    "editor.selectionHighlightBackground": "#d6416f22",
    "editor.lineHighlightBackground": "#1d1d37",
    "editor.findMatchBackground": "#b8dcff55",
    "editor.findMatchHighlightBackground": "#b8dcff33",
    "editorWhitespace.foreground": "#363850",
    "editorIndentGuide.background1": "#292b43",
    "editorIndentGuide.activeBackground1": "#4f5269",
    "editorBracketMatch.border": "#b8dcff",
    "editorWidget.background": "#0c0c20",
    "editorHoverWidget.background": "#0c0c20",
    "editorSuggestWidget.background": "#0c0c20",
    "editorSuggestWidget.selectedBackground": "#4b1f3f",
    "sideBar.background": "#0c0c20",
    "sideBar.foreground": "#c3ccdd",
    "sideBarTitle.foreground": "#e2edfc",
    "sideBarSectionHeader.background": "#090917",
    "activityBar.background": "#6e0a33",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#af788f",
    "activityBarBadge.background": "#d6416f",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#090917",
    "titleBar.activeForeground": "#e2edfc",
    "titleBar.inactiveBackground": "#090917",
    "statusBar.background": "#6e0a33",
    "statusBar.foreground": "#f1e7eb",
    "statusBar.noFolderBackground": "#6e0a33",
    "statusBar.debuggingBackground": "#d6416f",
    "tab.activeBackground": "#10102a",
    "tab.inactiveBackground": "#0c0c20",
    "tab.activeForeground": "#e2edfc",
    "tab.inactiveForeground": "#797f93",
    "tab.activeBorderTop": "#b8dcff",
    "tab.border": "#090917",
    "editorGroupHeader.tabsBackground": "#0c0c20",
    "editorGroup.border": "#090917",
    "panel.background": "#10102a",
    "panel.border": "#090917",
    "panelTitle.activeForeground": "#e2edfc",
    "panelTitle.inactiveForeground": "#797f93",
    "list.activeSelectionBackground": "#4b1f3f",
    "list.activeSelectionForeground": "#e2edfc",
    "list.hoverBackground": "#1d1d37",
    "list.highlightForeground": "#b8dcff",
    "badge.background": "#d6416f",
    "badge.foreground": "#ffffff",
    "button.background": "#d6416f",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#d85b84",
    "progressBar.background": "#b8dcff",
    "input.background": "#1d1d37",
    "input.foreground": "#e2edfc",
    "input.border": "#30314a",
    "inputOption.activeBorder": "#b8dcff",
    "dropdown.background": "#0c0c20",
    "scrollbarSlider.background": "#e2edfc22",
    "scrollbarSlider.hoverBackground": "#e2edfc33",
    "scrollbarSlider.activeBackground": "#e2edfc44",
    "textLink.foreground": "#b8dcff",
    "textLink.activeForeground": "#5aa9ff",
    "gitDecoration.modifiedResourceForeground": "#b8dcff",
    "gitDecoration.addedResourceForeground": "#5aa9ff",
    "gitDecoration.deletedResourceForeground": "#e46164",
    "gitDecoration.untrackedResourceForeground": "#d6416f",
    "terminal.background": "#10102a",
    "terminal.foreground": "#e2edfc",
    "terminalCursor.foreground": "#b8dcff",
    "minimap.selectionHighlight": "#d6416f"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#797f93",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5aa9ff"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#89c3ff"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#d6416f"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#9fa6b9"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#b8dcff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#bedfff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e2edfc"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d8e9fd"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#d6416f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#d6416f"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b8dcff"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#bcdeff"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#b8dcff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#5aa9ff"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
