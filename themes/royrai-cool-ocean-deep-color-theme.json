{
  "name": "RoyrAI Cool Ocean Deep",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#023e8a",
    "foreground": "#c0e7f3",
    "editor.background": "#09111f",
    "editor.foreground": "#c0e7f3",
    "editorLineNumber.foreground": "#526774",
    "editorLineNumber.activeForeground": "#48cae4",
    "editorCursor.foreground": "#48cae4",
    "editor.selectionBackground": "#071f3f",
    "editor.selectionHighlightBackground": "#023e8a22",
    "editor.lineHighlightBackground": "#141e2c",
    "editor.findMatchBackground": "#48cae455",
    "editor.findMatchHighlightBackground": "#48cae433",
    "editorWhitespace.foreground": "#2a3845",
    "editorIndentGuide.background1": "#1f2b38",
    "editorIndentGuide.activeBackground1": "#40515f",
    "editorBracketMatch.border": "#48cae4",
    "editorWidget.background": "#070d17",
    "editorHoverWidget.background": "#070d17",
    "editorSuggestWidget.background": "#070d17",
    "editorSuggestWidget.selectedBackground": "#071f3f",
    "sideBar.background": "#070d17",
    "sideBar.foreground": "#a5c7d3",
    "sideBarTitle.foreground": "#c0e7f3",
    "sideBarSectionHeader.background": "#050911",
    "activityBar.background": "#05446b",
