    "activityBarBadge.background": "#f7c9d4",
    "activityBarBadge.foreground": "#111111",
    "titleBar.activeBackground": "#150f12",
    "titleBar.activeForeground": "#f5e7ef",
    "titleBar.inactiveBackground": "#150f12",
    "statusBar.background": "#150f12",
