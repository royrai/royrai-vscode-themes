{
  "name": "RoyrAI Crystals Rose Quartz",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#f7c9d4",
    "foreground": "#f5e7ef",
    "editor.background": "#261c21",
    "editor.foreground": "#f5e7ef",
    "editorLineNumber.foreground": "#796d73",
    "editorLineNumber.activeForeground": "#d28a9c",
    "editorCursor.foreground": "#d28a9c",
    "editor.selectionBackground": "#655057",
