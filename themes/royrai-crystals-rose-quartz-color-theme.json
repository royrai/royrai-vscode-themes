    "editor.lineHighlightBackground": "#32282d",
    "editor.findMatchBackground": "#d28a9c55",
    "editor.findMatchHighlightBackground": "#d28a9c33",
    "editorWhitespace.foreground": "#4b4146",
    "editorIndentGuide.background1": "#3f343a",
    "editorIndentGuide.activeBackground1": "#64595f",
    "editorBracketMatch.border": "#d28a9c",
    "editorWidget.background": "#1d1519",
