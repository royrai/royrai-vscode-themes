    "editorSuggestWidget.background": "#1d1519",
    "editorSuggestWidget.selectedBackground": "#655057",
    "sideBar.background": "#1d1519",
    "sideBar.foreground": "#d6c9d0",
    "sideBarTitle.foreground": "#f5e7ef",
    "sideBarSectionHeader.background": "#150f12",
    "activityBar.background": "#150f12",
