    "statusBar.debuggingBackground": "#386641",
    "tab.activeBackground": "#101714",
    "tab.inactiveBackground": "#0c110f",
    "tab.activeForeground": "#dde7c9",
    "tab.inactiveForeground": "#777f6f",
    "tab.activeBorderTop": "#a7c957",
    "tab.border": "#090d0b",
    "editorGroupHeader.tabsBackground": "#0c110f",
    "editorGroup.border": "#090d0b",
    "panel.background": "#101714",
    "panel.border": "#090d0b",
    "panelTitle.activeForeground": "#dde7c9",
    "panelTitle.inactiveForeground": "#777f6f",
    "list.activeSelectionBackground": "#1c2f22",
    "list.activeSelectionForeground": "#dde7c9",
    "list.hoverBackground": "#1c231f",
    "list.highlightForeground": "#a7c957",
    "badge.background": "#386641",
    "badge.foreground": "#ffffff",
    "button.background": "#386641",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#517955",
    "progressBar.background": "#a7c957",
    "input.background": "#1c231f",
    "input.foreground": "#dde7c9",
    "input.border": "#2f362f",
    "inputOption.activeBorder": "#a7c957",
    "dropdown.background": "#0c110f",
    "scrollbarSlider.background": "#dde7c922",
    "scrollbarSlider.hoverBackground": "#dde7c933",
    "scrollbarSlider.activeBackground": "#dde7c944",
    "textLink.foreground": "#a7c957",
    "textLink.activeForeground": "#6a994e",
    "gitDecoration.modifiedResourceForeground": "#a7c957",
    "gitDecoration.addedResourceForeground": "#6a994e",
    "gitDecoration.deletedResourceForeground": "#e3605a",
    "gitDecoration.untrackedResourceForeground": "#386641",
    "terminal.background": "#101714",
    "terminal.foreground": "#dde7c9",
    "terminalCursor.foreground": "#a7c957",
    "minimap.selectionHighlight": "#386641"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#777f6f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6a994e"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#89b153"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#386641"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#9ba48f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#a7c957"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#afce68"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#dde7c9"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d0e0ad"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#386641",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#386641"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a7c957"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#accc62"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#a7c957",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#6a994e"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
