{
  "name": "RoyrAI Warm Burgundy Persimmon",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#ff5a2b",
    "foreground": "#f0f0f4",
    "editor.background": "#22060f",
    "editor.foreground": "#f0f0f4",
    "editorLineNumber.foreground": "#74646b",
    "editorLineNumber.activeForeground": "#e6e6e6",
    "editorCursor.foreground": "#e6e6e6",
    "editor.selectionBackground": "#641f17",
    "editor.selectionHighlightBackground": "#ff5a2b22",
    "editor.lineHighlightBackground": "#2e141d",
    "editor.findMatchBackground": "#e6e6e655",
    "editor.findMatchHighlightBackground": "#e6e6e633",
    "editorWhitespace.foreground": "#473038",
    "editorIndentGuide.background1": "#3b222a",
    "editorIndentGuide.activeBackground1": "#604c54",
    "editorBracketMatch.border": "#e6e6e6",
    "editorWidget.background": "#1a050b",
    "editorHoverWidget.background": "#1a050b",
    "editorSuggestWidget.background": "#1a050b",
    "editorSuggestWidget.selectedBackground": "#641f17",
    "sideBar.background": "#1a050b",
    "sideBar.foreground": "#d1cdd2",
    "sideBarTitle.foreground": "#f0f0f4",
    "sideBarSectionHeader.background": "#130308",
    "activityBar.background": "#870c3e",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#bd7995",
    "activityBarBadge.background": "#ff5a2b",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#130308",
    "titleBar.activeForeground": "#f0f0f4",
    "titleBar.inactiveBackground": "#130308",
    "statusBar.background": "#870c3e",
    "statusBar.foreground": "#f3e7ec",
    "statusBar.noFolderBackground": "#870c3e",
    "statusBar.debuggingBackground": "#ff5a2b",
    "tab.activeBackground": "#22060f",
    "tab.inactiveBackground": "#1a050b",
    "tab.activeForeground": "#f0f0f4",
    "tab.inactiveForeground": "#897b82",
    "tab.activeBorderTop": "#e6e6e6",
    "tab.border": "#130308",
    "editorGroupHeader.tabsBackground": "#1a050b",
    "editorGroup.border": "#130308",
    "panel.background": "#22060f",
    "panel.border": "#130308",
    "panelTitle.activeForeground": "#f0f0f4",
    "panelTitle.inactiveForeground": "#897b82",
    "list.activeSelectionBackground": "#641f17",
    "list.activeSelectionForeground": "#f0f0f4",
    "list.hoverBackground": "#2e141d",
    "list.highlightForeground": "#e6e6e6",
    "badge.background": "#ff5a2b",
    "badge.foreground": "#ffffff",
    "button.background": "#ff5a2b",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#fd7149",
    "progressBar.background": "#e6e6e6",
    "input.background": "#2e141d",
    "input.foreground": "#f0f0f4",
    "input.border": "#412931",
    "inputOption.activeBorder": "#e6e6e6",
    "dropdown.background": "#1a050b",
    "scrollbarSlider.background": "#f0f0f422",
    "scrollbarSlider.hoverBackground": "#f0f0f433",
    "scrollbarSlider.activeBackground": "#f0f0f444",
    "textLink.foreground": "#e6e6e6",
    "textLink.activeForeground": "#e0557f",
    "gitDecoration.modifiedResourceForeground": "#e6e6e6",
    "gitDecoration.addedResourceForeground": "#e0557f",
    "gitDecoration.deletedResourceForeground": "#e76262",
    "gitDecoration.untrackedResourceForeground": "#ff5a2b",
    "terminal.background": "#22060f",
    "terminal.foreground": "#f0f0f4",
    "terminalCursor.foreground": "#e6e6e6",
    "minimap.selectionHighlight": "#ff5a2b"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#897b82",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e0557f"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#e39eb3"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#ff5a2b"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#aea5ab"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#e6e6e6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#e8e8e8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#f0f0f4"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#eeeef1"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#ff5a2b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ff5a2b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e6e6e6"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#e7e7e7"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e6e6e6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#e0557f"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
