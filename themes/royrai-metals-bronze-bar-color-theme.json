{
  "name": "RoyrAI Metals Bronze Bar",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#7a3e1e",
    "foreground": "#ead3c7",
    "editor.background": "#2a100e",
    "editor.foreground": "#ead3c7",
    "editorLineNumber.foreground": "#775e58",
    "editorLineNumber.activeForeground": "#d2854f",
    "editorCursor.foreground": "#d2854f",
    "editor.selectionBackground": "#421e13",
    "editor.selectionHighlightBackground": "#7a3e1e22",
    "editor.lineHighlightBackground": "#361c19",
    "editor.findMatchBackground": "#d2854f55",
    "editor.findMatchHighlightBackground": "#d2854f33",
    "editorWhitespace.foreground": "#4d332f",
    "editorIndentGuide.background1": "#412724",
    "editorIndentGuide.activeBackground1": "#644b46",
    "editorBracketMatch.border": "#d2854f",
    "editorWidget.background": "#200c0b",
    "editorHoverWidget.background": "#200c0b",
    "editorSuggestWidget.background": "#200c0b",
    "editorSuggestWidget.selectedBackground": "#421e13",
    "sideBar.background": "#200c0b",
    "sideBar.foreground": "#cdb6ab",
    "sideBarTitle.foreground": "#ead3c7",
    "sideBarSectionHeader.background": "#170908",
    "activityBar.background": "#170908",
    "activityBar.foreground": "#d2854f",
    "activityBar.inactiveForeground": "#806861",
    "activityBarBadge.background": "#7a3e1e",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#170908",
    "titleBar.activeForeground": "#ead3c7",
    "titleBar.inactiveBackground": "#170908",
    "statusBar.background": "#170908",
    "statusBar.foreground": "#d7c0b5",
    "statusBar.noFolderBackground": "#170908",
    "statusBar.debuggingBackground": "#7a3e1e",
    "tab.activeBackground": "#2a100e",
    "tab.inactiveBackground": "#200c0b",
    "tab.activeForeground": "#ead3c7",
    "tab.inactiveForeground": "#8a726b",
    "tab.activeBorderTop": "#d2854f",
    "tab.border": "#170908",
    "editorGroupHeader.tabsBackground": "#200c0b",
    "editorGroup.border": "#170908",
    "panel.background": "#2a100e",
    "panel.border": "#170908",
    "panelTitle.activeForeground": "#ead3c7",
    "panelTitle.inactiveForeground": "#8a726b",
    "list.activeSelectionBackground": "#421e13",
    "list.activeSelectionForeground": "#ead3c7",
    "list.hoverBackground": "#361c19",
    "list.highlightForeground": "#d2854f",
    "badge.background": "#7a3e1e",
    "badge.foreground": "#ffffff",
    "button.background": "#7a3e1e",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#8b5437",
    "progressBar.background": "#d2854f",
    "input.background": "#361c19",
    "input.foreground": "#ead3c7",
    "input.border": "#472d2a",
    "inputOption.activeBorder": "#d2854f",
    "dropdown.background": "#200c0b",
    "scrollbarSlider.background": "#ead3c722",
    "scrollbarSlider.hoverBackground": "#ead3c733",
    "scrollbarSlider.activeBackground": "#ead3c744",
    "textLink.foreground": "#d2854f",
    "textLink.activeForeground": "#a85a30",
    "gitDecoration.modifiedResourceForeground": "#d2854f",
    "gitDecoration.addedResourceForeground": "#a85a30",
    "gitDecoration.deletedResourceForeground": "#e65c59",
    "gitDecoration.untrackedResourceForeground": "#7a3e1e",
    "terminal.background": "#2a100e",
    "terminal.foreground": "#ead3c7",
    "terminalCursor.foreground": "#d2854f",
    "minimap.selectionHighlight": "#7a3e1e"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a726b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a85a30"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#bd7040"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#7a3e1e"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#ad958c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d2854f"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#d69161"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ead3c7"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e4c0a9"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#7a3e1e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7a3e1e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d2854f"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#d48d5b"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#d2854f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#a85a30"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff5370"
      }
    }
  ]
}
